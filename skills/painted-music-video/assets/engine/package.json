{
  "name": "painted-music-video",
  "version": "1.0.0",
  "private": true,
  "description": "A hand-painted, lyric-synced music video, made with p5.js and p5.brush",
  "scripts": {
    "cast": "node render.mjs --loop=cast --sheet=1 --cols=1 --w=1920 --out=out/check/cast.jpg",
    "frames": "node render.mjs --frames --workers=3",
    "encode": "node render.mjs --encode --out=out/video.mp4"
  },
  "dependencies": {
    "p5": "^2.3.3",
    "p5.brush": "^2.2.3",
    "puppeteer-core": "^25.11.0"
  }
}
